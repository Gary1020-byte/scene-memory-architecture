# ⛔ This repo is "public method + pure shell templates", not a DSH installer.
# Nothing below belongs in the public repo: run data, sessions, credentials, models, backups, workspaces.

# Sessions and runtime data
/.dsh/
sessions/
attachments/
session-archive/
workspaces/
backups/

# Dependencies and build artifacts
dist/
build/
out/
*.tgz

# Models and large binaries
models/
model/
*.gguf
*.safetensors
*.onnx

# Logs and databases
logs/
*.db
*.sqlite
*.sqlite3

# Keys and local config
.env
.env.*
*credential*
*credentials*
*secret*
*keyfile*
cloudflare.env
github.env

# OS and editor junk
Thumbs.db
desktop.ini
.vscode/
.idea/
_tmp/
tmp/

# ⛔ Each scene inside the demo workbench is its own git repository — but the demo
# deliberately does NOT ship a real git repository.
# (A nested git repo with no commits makes `git add -A` fail outright: git treats
# it as a submodule.)
# So the demo's `.git` is an "explanation file" rather than a git repo, and it MUST
# be committed to the public repo. See the contents of
# 04-templates/demo-workbench/.git-marker.
#
# When you actually use this: run `git init` to create a real directory — do not
# leave just the explanation file.

# Execution traces from the demo workbench (running the tools produces archive
# snapshots and project memory files)
04-templates/demo-workbench*/scenes/*/project-memory/*.md
04-templates/demo-workbench*/scenes/*/archive/*.md
