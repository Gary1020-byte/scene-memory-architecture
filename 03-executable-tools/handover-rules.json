  "boundaryMarkerFile": ".git",
  "boundaryMarkerAltFile": ".git-marker",
  "_boundaryMarkerNote": "A scene IS an independent git repository; the engine determines the boundary by finding the nearest `.git` while walking up. The validation tool accepts either `.git` or `.git-marker`. The demo workbench in the public repo cannot ship a real git repository (a nested repo with no commits makes `git add -A` fail: git treats it as a submodule), and git does not track a file named `.git` — so the demo uses a `.git-marker` explanation file instead. Users creating their own scenes must always use a real `.git` directory.",
  "workflowDir": "workflows",
